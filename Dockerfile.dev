# 로컬 데모용 개발 이미지. 소스는 compose에서 마운트하므로 여기서는 gem만 설치한다.
# 운영용 이미지는 Dockerfile을 쓴다.
ARG RUBY_VERSION=4.0.2
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential curl git libyaml-dev pkg-config libvips sqlite3 && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

COPY vendor/* ./vendor/
COPY Gemfile Gemfile.lock ./
RUN bundle install

EXPOSE 3000
CMD ["bin/docker-dev"]
