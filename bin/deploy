#!/usr/bin/env bash
# 레지스트리 아이디와 액세스 토큰을 입력받아 bin/kamal을 실행한다. 사용법과 절차는 docs/deployment.md.
#
#   bin/deploy                    # = bin/kamal deploy
#   bin/deploy setup              # 최초 1회: 서버 준비 + Traccar + 앱
#   bin/deploy rollback <버전>     # 그 밖의 kamal 명령도 그대로 넘긴다
#
# 값은 이 프로세스의 환경변수로만 두고 파일에 쓰지 않는다. 이미 환경변수에 있으면 묻지 않는다
# (KAMAL_REGISTRY_USERNAME, KAMAL_REGISTRY_PASSWORD). .kamal/secrets가 이 값을 읽어 간다.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ $# -eq 0 ]; then
  set -- deploy
fi

if [ -z "${KAMAL_REGISTRY_USERNAME:-}" ]; then
  printf "레지스트리 사용자 이름: "
  read -r KAMAL_REGISTRY_USERNAME
fi
if [ -z "${KAMAL_REGISTRY_PASSWORD:-}" ]; then
  printf "레지스트리 액세스 토큰 (입력이 보이지 않는다): "
  read -r -s KAMAL_REGISTRY_PASSWORD
  echo
fi

# 붙여넣을 때 끼는 공백·개행을 지운다(이름과 토큰에는 공백이 없다).
KAMAL_REGISTRY_USERNAME="${KAMAL_REGISTRY_USERNAME//[[:space:]]/}"
KAMAL_REGISTRY_PASSWORD="${KAMAL_REGISTRY_PASSWORD//[[:space:]]/}"

if [ -z "$KAMAL_REGISTRY_USERNAME" ]; then
  echo "사용자 이름이 비어 있다" >&2
  exit 1
fi
if [ -z "$KAMAL_REGISTRY_PASSWORD" ]; then
  echo "액세스 토큰이 비어 있다" >&2
  exit 1
fi

export KAMAL_REGISTRY_USERNAME KAMAL_REGISTRY_PASSWORD

# 이미지를 올리는 명령은 운영 키와 Traccar 토큰이 없으면 부팅하지 못하는 컨테이너를 만든다. 올리기 전에 막는다.
case "$1" in
  deploy | setup | redeploy)
    missing=()
    [ -s config/credentials/production.key ] || missing+=("config/credentials/production.key (bin/rails credentials:edit --environment production)")
    [ -n "${TRACCAR_API_TOKEN:-}" ] || missing+=("환경변수 TRACCAR_API_TOKEN (openssl rand -hex 32)")
    [ -n "${TRACCAR_INGEST_TOKEN:-}" ] || missing+=("환경변수 TRACCAR_INGEST_TOKEN (openssl rand -hex 32)")
    if [ ${#missing[@]} -gt 0 ]; then
      echo "배포에 필요한 값이 없다:" >&2
      printf '  - %s\n' "${missing[@]}" >&2
      echo "자세한 설명은 docs/deployment.md" >&2
      exit 1
    fi
    ;;
esac

bin/kamal "$@"

echo "Done"
