#!/usr/bin/env bash
# 레지스트리 아이디와 액세스 토큰을 입력받아 bin/kamal을 실행한다. 사용법과 절차는 docs/deployment.md.
#
#   bin/deploy                    # = bin/kamal deploy
#   bin/deploy setup              # 최초 1회: 서버 준비 + Traccar + 앱
#   bin/deploy rollback <버전>     # 그 밖의 kamal 명령도 그대로 넘긴다
#
# 값은 이 프로세스의 환경변수로만 둔다(.kamal/secrets가 읽어 간다). 우선순위는
# 이미 있는 환경변수 > .env.deploy 파일 > gh 로그인 > 입력 프롬프트다. 파일 위치는 DEPLOY_ENV_FILE로 바꾼다.
# 파일에서 읽는 이름은 아래 다섯 개뿐이다. 형식은 .env와 같다(KEY=값, 주석 #, 따옴표 허용).
#   KAMAL_REGISTRY_USERNAME  KAMAL_REGISTRY_PASSWORD  TRACCAR_API_TOKEN  TRACCAR_INGEST_TOKEN
#   TRACCAR_ADMIN_HTPASSWD  (Traccar 관리 화면 브라우저 인증. admin:$apr1$... 한 줄, 작은따옴표로 감싼다)
set -euo pipefail
cd "$(dirname "$0")/.."

# docker compose가 .env를 자동으로 읽으므로 compose 설정과 섞이지 않게 .env.deploy를 쓴다(둘 다 git에서 무시된다).
ENV_FILE="${DEPLOY_ENV_FILE:-.env.deploy}"
ALLOWED=" KAMAL_REGISTRY_USERNAME KAMAL_REGISTRY_PASSWORD TRACCAR_API_TOKEN TRACCAR_INGEST_TOKEN TRACCAR_ADMIN_HTPASSWD "

# 코드를 실행하지 않도록 source 하지 않고 한 줄씩 읽는다. 이미 설정된 환경변수는 덮어쓰지 않는다.
load_env_file() {
  local file="$1" line key value
  if [ -n "$(find "$file" \( -perm -040 -o -perm -004 \) 2>/dev/null)" ]; then
    echo "경고: $file 을 다른 사용자도 읽을 수 있다. chmod 600 $file" >&2
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in "" | "#"*) continue ;; esac
    line="${line#export }"
    key="${line%%=*}"
    value="${line#*=}"
    key="${key//[[:space:]]/}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    case "$ALLOWED" in
      *" $key "*) ;;
      *) echo "경고: $file 의 $key 는 bin/deploy가 쓰지 않아 무시한다" >&2; continue ;;
    esac
    if [ "${value#\"}" != "$value" ] && [ "${value%\"}" != "$value" ]; then value="${value:1:${#value}-2}"; fi
    if [ "${value#\'}" != "$value" ] && [ "${value%\'}" != "$value" ]; then value="${value:1:${#value}-2}"; fi
    if [ -z "${!key:-}" ]; then export "$key=$value"; fi
  done < "$file"
}

if [ -f "$ENV_FILE" ]; then
  load_env_file "$ENV_FILE"
elif [ -n "${DEPLOY_ENV_FILE:-}" ]; then
  echo "DEPLOY_ENV_FILE=$ENV_FILE 파일이 없다" >&2
  exit 1
fi

if [ $# -eq 0 ]; then
  set -- deploy
fi

# 레지스트리 값이 아직 없으면 gh(GitHub CLI) 로그인을 쓴다. 토큰은 gh auth token, 이름은 로그인한 GitHub 계정이다.
# GHCR에 올리려면 토큰에 write:packages 권한이 있어야 하므로 먼저 확인하고, 없으면 추가 방법을 알려 주고 멈춘다.
if [ -z "${KAMAL_REGISTRY_PASSWORD:-}" ] && command -v gh > /dev/null 2>&1 && gh auth status > /dev/null 2>&1; then
  gh_token="$(gh auth token 2> /dev/null || true)"
  if [ -n "$gh_token" ]; then
    scopes="$(curl -s -m 10 -D - -o /dev/null -H "Authorization: Bearer $gh_token" https://api.github.com/user | tr -d '\r' | grep -i '^x-oauth-scopes:' || true)"
    case "$scopes" in
      *write:packages*) ;;
      *)
        echo "gh 로그인에 write:packages 권한이 없어 GHCR에 올릴 수 없다. 권한을 추가한다:" >&2
        echo "  gh auth refresh -h github.com -s write:packages" >&2
        echo "(gh를 쓰지 않으려면 KAMAL_REGISTRY_PASSWORD에 클래식 PAT을 두거나 gh auth logout 한다)" >&2
        exit 1
        ;;
    esac
    KAMAL_REGISTRY_PASSWORD="$gh_token"
    if [ -z "${KAMAL_REGISTRY_USERNAME:-}" ]; then
      KAMAL_REGISTRY_USERNAME="$(gh api user -q .login 2> /dev/null || true)"
    fi
    echo "gh 로그인(${KAMAL_REGISTRY_USERNAME:-?})의 토큰을 레지스트리 토큰으로 쓴다. Kamal이 서버에도 같은 토큰으로 로그인하므로 서버의 Docker 설정에 남는다." >&2
  fi
  unset gh_token scopes
fi

if [ -z "${KAMAL_REGISTRY_USERNAME:-}" ]; then
  printf "레지스트리 사용자 이름: "
  read -r KAMAL_REGISTRY_USERNAME
fi
if [ -z "${KAMAL_REGISTRY_PASSWORD:-}" ]; then
  printf "레지스트리 액세스 토큰 (입력이 보이지 않는다): "
  read -r -s KAMAL_REGISTRY_PASSWORD
  echo
fi

# 붙여넣을 때 끼는 공백·개행을 지운다(이름과 토큰에는 공백이 없다).
KAMAL_REGISTRY_USERNAME="${KAMAL_REGISTRY_USERNAME//[[:space:]]/}"
KAMAL_REGISTRY_PASSWORD="${KAMAL_REGISTRY_PASSWORD//[[:space:]]/}"

if [ -z "$KAMAL_REGISTRY_USERNAME" ]; then
  echo "사용자 이름이 비어 있다" >&2
  exit 1
fi
if [ -z "$KAMAL_REGISTRY_PASSWORD" ]; then
  echo "액세스 토큰이 비어 있다" >&2
  exit 1
fi

export KAMAL_REGISTRY_USERNAME KAMAL_REGISTRY_PASSWORD

# 이미지를 올리는 명령은 운영 키와 Traccar 토큰이 없으면 부팅하지 못하는 컨테이너를 만든다. 올리기 전에 막는다.
case "$1" in
  deploy | setup | redeploy)
    missing=()
    [ -s config/credentials/production.key ] || missing+=("config/credentials/production.key (bin/rails credentials:edit --environment production)")
    [ -n "${TRACCAR_API_TOKEN:-}" ] || missing+=("TRACCAR_API_TOKEN (환경변수 또는 $ENV_FILE, openssl rand -hex 32)")
    [ -n "${TRACCAR_INGEST_TOKEN:-}" ] || missing+=("TRACCAR_INGEST_TOKEN (환경변수 또는 $ENV_FILE, openssl rand -hex 32)")
    if [ ${#missing[@]} -gt 0 ]; then
      echo "배포에 필요한 값이 없다:" >&2
      printf '  - %s\n' "${missing[@]}" >&2
      echo "자세한 설명은 docs/deployment.md" >&2
      exit 1
    fi
    ;;
esac

# traccar-proxy accessory(setup은 모든 accessory를 올린다)는 관리 화면 비밀번호 해시가 있어야 설정 파일을 만든다.
# 해시에 $가 있어 따옴표 없이 쓰면 깨지므로 모양도 본다.
case "$1" in
  setup | accessory)
    if [ -z "${TRACCAR_ADMIN_HTPASSWD:-}" ]; then
      echo "TRACCAR_ADMIN_HTPASSWD가 없다(환경변수 또는 $ENV_FILE). printf 'admin:%s\n' \"\$(openssl passwd -apr1)\" 로 만든다. docs/traccar-accessory.md" >&2
      exit 1
    fi
    case "$TRACCAR_ADMIN_HTPASSWD" in
      ?*:\$apr1\$* | ?*:\$2[aby]\$*) ;;
      *) echo "TRACCAR_ADMIN_HTPASSWD 모양이 이상하다. '이름:\$apr1\$...' 형식이어야 한다(작은따옴표로 감쌌는지 확인)" >&2; exit 1 ;;
    esac
    ;;
esac

bin/kamal "$@"

echo "Done"
