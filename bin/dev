#!/usr/bin/env sh

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

# Default to port 3000 if not specified
export PORT="${PORT:-3000}"
# foreman은 프로세스마다 PORT를 다르게 준다(web 3000, css 3100, ...). bin/traccar가 Rails 포트를 알 수 있게 따로 넘긴다.
export RAILS_PORT="$PORT"

# Procfile.dev의 traccar(bin/traccar dev)는 도커 컨테이너다. Rails는 그 Traccar를 쓰도록 접속 값을 맞추고(credentials의
# 원격 서버로 새지 않게), 컨테이너가 호스트 Rails로 이벤트를 포워딩할 수 있게 모든 인터페이스에 바인딩한다.
# Traccar를 쓰지 않으면(TRACCAR=0) 아무것도 바꾸지 않는다.
if [ "${TRACCAR:-1}" != "0" ] && command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  export TRACCAR_API_BASE_URL="${TRACCAR_API_BASE_URL:-http://localhost:8082}"
  export TRACCAR_API_TOKEN="${TRACCAR_API_TOKEN:-dev-traccar-api-token}"
  export TRACCAR_INGEST_TOKEN="${TRACCAR_INGEST_TOKEN:-dev-traccar-token}"
  export BINDING="${BINDING:-0.0.0.0}"
fi

# Let the debug gem allow remote connections,
# but avoid loading until `debugger` is called
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

exec foreman start -f Procfile.dev "$@"
