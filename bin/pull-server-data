#!/usr/bin/env bash
# 실서버(web01)의 백업 스냅샷을 로컬로 내려받는다. 서버 쪽 데이터는 읽기만 한다.
# 대체 절차와 주의점은 docs/deployment.md "서버 데이터를 로컬로 가져오기" 절.
#
# 스냅샷은 서버의 cron 백업(bin/backup-storage, bin/backup-traccar)이 만든 일관된
# 복사본을 쓴다. 실행 중인 SQLite·H2 파일을 직접 내려받으면 깨질 수 있으므로
# 스냅샷 외에는 받지 않는다.
#
#   bin/pull-server-data           # 서버에 있는 최신 백업 스냅샷을 내려받는다
#   bin/pull-server-data --fresh   # 서버에서 새 백업을 만든 뒤 내려받는다 (Traccar가 수 초 정지)
#
#   SERVER              SSH 별칭 (기본 web01.where-is-my-bus)
#   SERVER_BACKUP_DIR   서버 백업 위치 (기본 /var/backups/where-is-my-bus)
#   OUT_DIR             저장 위치 (기본 tmp/production-<서버 백업 시각> — gitignore라 커밋되지 않는다)

set -euo pipefail

SERVER="${SERVER:-web01.where-is-my-bus}"
SERVER_BACKUP_DIR="${SERVER_BACKUP_DIR:-/var/backups/where-is-my-bus}"

FRESH=0
for arg in "$@"; do
  case "$arg" in
    --fresh) FRESH=1 ;;
    *) { echo "알 수 없는 인수: $arg (사용법: bin/pull-server-data [--fresh])" >&2; exit 1; } ;;
  esac
done

command -v ssh >/dev/null || { echo "ssh가 필요합니다" >&2; exit 1; }
ssh -o ConnectTimeout=10 -o BatchMode=yes "$SERVER" true 2>/dev/null \
  || { echo "서버에 접속할 수 없습니다: $SERVER (SSH 별칭을 확인하라)" >&2; exit 1; }

if [ "$FRESH" = "1" ]; then
  echo "== 서버에서 새 백업을 만든다 (Traccar가 수 초 정지) =="
  ssh "$SERVER" "sudo /opt/where-is-my-bus/backup-storage >/dev/null" \
    || { echo "backup-storage 실행 실패" >&2; exit 1; }
  ssh "$SERVER" "sudo /opt/where-is-my-bus/backup-traccar >/dev/null" \
    || { echo "backup-traccar 실행 실패" >&2; exit 1; }
fi

# 서버의 최신 스냅샷: SQLite 백업은 시각 디렉터리, Traccar 백업은 traccar-*.tar.gz
latest_dir="$(ssh "$SERVER" "sudo ls -1t $SERVER_BACKUP_DIR | grep -E '^[0-9]{8}-[0-9]{6}' | head -1")"
[ -n "$latest_dir" ] || { echo "서버에 SQLite 백업 디렉터리가 없습니다: $SERVER_BACKUP_DIR" >&2; exit 1; }
latest_tar="$(ssh "$SERVER" "sudo ls -1t $SERVER_BACKUP_DIR | grep '^traccar-.*\.tar\.gz$' | head -1")"
[ -n "$latest_tar" ] || { echo "서버에 Traccar 백업 tar가 없습니다: $SERVER_BACKUP_DIR" >&2; exit 1; }
echo "서버 스냅샷: $latest_dir / $latest_tar"

out="${OUT_DIR:-tmp/production-$latest_dir}"
mkdir -p "$out/rails"
trap 'echo "실패: $out 은 불완전하니 지우고 다시 시도하라" >&2' ERR

echo "== 내려받는다: $out/rails/ =="
files=()
while IFS= read -r f; do
  [ -n "$f" ] && files+=("$f")
done < <(ssh "$SERVER" "sudo ls -1 '$SERVER_BACKUP_DIR/$latest_dir'")
[ "${#files[@]}" -gt 0 ] || { echo "백업 디렉터리가 비어 있습니다: $latest_dir" >&2; exit 1; }
for f in "${files[@]}"; do
  ssh -n "$SERVER" "sudo cat '$SERVER_BACKUP_DIR/$latest_dir/$f'" > "$out/rails/$f"
  echo "  $f ($(wc -c < "$out/rails/$f" | tr -d ' ') bytes)"
done

echo "== 내려받는다: $out/$latest_tar =="
ssh "$SERVER" "sudo cat '$SERVER_BACKUP_DIR/$latest_tar'" > "$out/$latest_tar"
echo "  $latest_tar ($(wc -c < "$out/$latest_tar" | tr -d ' ') bytes)"

echo "== 검사한다 =="
for gz in "$out/rails"/*.sqlite3.gz; do
  name="$(basename "$gz" .gz)"
  gunzip -t "$gz" || { echo "손상된 gzip: $gz" >&2; exit 1; }
  gunzip -c "$gz" > "$out/rails/$name"
done
command -v sqlite3 >/dev/null && {
  for db in "$out/rails"/*.sqlite3; do
    result="$(sqlite3 "$db" 'PRAGMA integrity_check;')"
    [ "$result" = "ok" ] || { echo "무결성 검사 실패: $db ($result)" >&2; exit 1; }
  done
}
tar -tzf "$out/$latest_tar" | grep -q 'database.mv.db' \
  || { echo "Traccar tar에 database.mv.db가 없습니다: $out/$latest_tar" >&2; exit 1; }
tar -xzf "$out/$latest_tar" -C "$out"

trap - ERR
echo "완료: $out"
echo "  rails/   — SQLite 스냅샷. 로컬 대체에는 production.sqlite3만 필요하고 cache·cable·queue는 버려도 된다"
echo "  traccar/ — 서버 백업의 H2 데이터"
echo "로컬 DB로 대체하는 절차와 주의점은 docs/deployment.md '서버 데이터를 로컬로 가져오기' 절을 보라."
echo "개인정보·비밀값(비밀번호 해시, deviceId, PIN)이 들어 있으니 쓴 뒤 지운다."
