#!/bin/bash
# 로컬 개발용 Traccar 서버를 도커 컨네이터 사용합니다.
#
#   bin/traccar [up]   기동(이미 있으면 재시작)하고 관리자 계정 설정
#   bin/traccar down   컨테이너 정지·삭제(데이터는 유지)
#   bin/traccar status 컨테이너·API 상태
#   bin/traccar logs   로그 follow
#   bin/traccar reset  컨테이너·데이터 삭제 후 새로 기동
#   bin/traccar dev    Procfile.dev 용(foreground): 기동 -> 로그 follow -> 종료 시 컨테이너 정지.
#                      Docker 를 쓸 수 없거나 TRACCAR=0 이면 건너뛰고 대기(foreman 의 다른 프로세스 유지).
#
# 구조: 폰/시뮬레이터 -> :5055(OsmAnd) -> Traccar -> 포워딩 -> Rails /integrations/traccar/positions
#       Rails(admin CRUD) -> :8082(REST API) -> Traccar
# 자세한 내용은 README "로컬 Traccar 서버" 참고.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NAME="wimb-traccar"
IMAGE="${TRACCAR_IMAGE:-traccar/traccar:6.14.4}"
API_PORT=8082
DEVICE_PORT=5055
RAILS_PORT="${RAILS_PORT:-${PORT:-3000}}"
DATA_DIR="${ROOT}/tmp/docker/volumes/traccar"

# 로컬 개발할 때 config/traccar.yml 같아야 합니다. 
# TRACCAR_API_EMAIL 등 ENV 로 덮어쓰면 Rails 도 같은 ENV 를 사용하여야 합니다.
ADMIN_EMAIL="${TRACCAR_API_EMAIL:-admin@localbus.test}"
ADMIN_PASSWORD="${TRACCAR_API_PASSWORD:-localbus}"
INGEST_TOKEN="${TRACCAR_INGEST_TOKEN:-dev-traccar-token}"

# 10초 안에 응답이 없으면 실패.
docker_ready() {
  command -v docker >/dev/null 2>&1 || { echo "docker is not installed" >&2; return 1; }
  docker info >/dev/null 2>&1 &
  local pid=$!
  for _ in $(seq 1 10); do
    kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
    sleep 1
  done
  kill "$pid" 2>/dev/null || true
  return 1
}

require_docker() {
  docker_ready && return 0
  echo "docker daemon is disconnected. run or restart docker desktop." >&2
  exit 1
}

stop_port_holders() {
  local id name
  for id in $(docker ps -q --filter "publish=${API_PORT}" --filter "publish=${DEVICE_PORT}"); do
    name="$(docker inspect --format '{{.Name}}' "$id" | sed 's|^/||')"
    [[ "$name" == "$NAME" ]] && continue
    echo "Stop previous container ${name} (${id})"
    docker stop "$id" >/dev/null
  done
}

write_config() {
  mkdir -p "${DATA_DIR}/conf" "${DATA_DIR}/data" "${DATA_DIR}/logs"
  # 시작할 때 마다 이 파일을 새로 만듭니다. DB Traccar 내장 H2(파일).
  cat >"${DATA_DIR}/conf/traccar.xml" <<EOF
<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>
    <entry key='config.default'>./conf/default.xml</entry>

    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password'></entry>

    <entry key='forward.type'>json</entry>
    <entry key='forward.url'>http://host.docker.internal:${RAILS_PORT}/integrations/traccar/positions</entry>
    <entry key='forward.header'>X-Ingest-Token: ${INGEST_TOKEN}</entry>
</properties>
EOF
}

wait_for_api() {
  for _ in $(seq 1 90); do
    curl -fsS -o /dev/null "http://localhost:${API_PORT}/api/server" && return 0
    echo 'Wait traccar to startup...'
    sleep 1
  done
  echo "traccar(${API_PORT}) time over(90 seconds). check bin/traccar logs" >&2
  exit 1
}

# Traccar는 첫 등록 사용자가 관리자다. 이미 있으면 등록은 거절되므로 로그인 가능 여부로 확인한다.
ensure_admin() {
  curl -sS -o /dev/null -X POST "http://localhost:${API_PORT}/api/users" \
    -H 'Content-Type: application/json' \
    -d "{\"name\":\"admin\",\"email\":\"${ADMIN_EMAIL}\",\"password\":\"${ADMIN_PASSWORD}\"}" || true
  # /api/server is always 200 OK. check if authentication with /api/devices 
  if curl -fsS -o /dev/null -u "${ADMIN_EMAIL}:${ADMIN_PASSWORD}" "http://localhost:${API_PORT}/api/devices"; then
    return 0
  fi
  echo "(${ADMIN_EMAIL}) can not login." >&2
  echo "   bin/traccar reset or set admin to TRACCAR_API_EMAIL/TRACCAR_API_PASSWORD" >&2
  return 1
}

print_ready() {
  echo
  echo "Traccar is ready.  console: http://localhost:${API_PORT}  (${ADMIN_EMAIL} / ${ADMIN_PASSWORD})"
  echo "   Receive Position(OsmAnd): http://localhost:${DEVICE_PORT}  >  Fowarding: http://host.docker.internal:${RAILS_PORT}"
  echo "   (driver_app: TRACCAR_SERVER_URL=http://10.0.2.2:${DEVICE_PORT})"
}

cmd_up() {
  require_docker
  stop_port_holders
  write_config

  if docker container inspect "$NAME" >/dev/null 2>&1; then
    echo "Restart docker ${NAME}.."
    docker restart "$NAME" >/dev/null
  else
    echo "Run docker ${NAME}..."
    docker pull "$IMAGE"
    docker run -d --name "$NAME" \
      --add-host=host.docker.internal:host-gateway \
      -p "${API_PORT}:8082" -p "${DEVICE_PORT}:5055" \
      -v "${DATA_DIR}/conf/traccar.xml:/opt/traccar/conf/traccar.xml:ro" \
      -v "${DATA_DIR}/data:/opt/traccar/data" \
      -v "${DATA_DIR}/logs:/opt/traccar/logs" \
      "$IMAGE" >/dev/null
  fi

  wait_for_api
  ensure_admin
  print_ready
}

cmd_down() {
  require_docker
  docker rm -f "$NAME" >/dev/null 2>&1 && echo "Stopped ${NAME}" || echo "${NAME} 컨테이너가 없습니다."
}

cmd_status() {
  require_docker
  docker ps -a --filter "name=^${NAME}$" --format 'container: {{.Names}}  {{.Status}}  {{.Ports}}'
  if curl -fsS -o /dev/null "http://localhost:${API_PORT}/api/server"; then
    echo "api: http://localhost:${API_PORT} OK"
  else
    echo "api: http://localhost:${API_PORT} no response"
  fi
}

cmd_logs() {
  require_docker
  exec docker logs -f --tail 100 "$NAME"
}

cmd_reset() {
  require_docker
  docker rm -f "$NAME" >/dev/null 2>&1 || true
  rm -rf "${DATA_DIR}"
  echo "Traccar data(${DATA_DIR}) : deleted."
  # Rails 에 저장된 traccar_*_id 가 사라진 리소스를 가리키므로 함께 비운다(이후 bin/rails traccar:sync 로 다시 만든다).
  (cd "$ROOT" && bin/rails traccar:reset_ids) || echo "traccar_*_id reset failed. run bin/rails traccar:reset_ids" >&2
  cmd_up
}

idle() {
  echo "$1"
  exec tail -f /dev/null
}

cmd_dev() {
  [[ "${TRACCAR:-1}" == "0" ]] && idle "TRACCAR=0 skip to boot local Traccar"
  docker_ready || idle "  Docker was failed to skip boot local Traccar. befere restarting bin/dev, run Docker Desktop"
  (cmd_up) || idle "  Booting local Traccar was failed."

  trap 'echo "Stop ${NAME}"; docker stop -t 5 "$NAME" >/dev/null 2>&1; exit 0' TERM INT
  docker logs -f --tail 0 "$NAME" &
  wait $! || true
  idle "   Traccar container is stopped. run bin/traccar up"
}

case "${1:-up}" in
  up)     cmd_up ;;
  down)   cmd_down ;;
  status) cmd_status ;;
  logs)   cmd_logs ;;
  reset)  cmd_reset ;;
  dev)    cmd_dev ;;
  *) echo "usage: bin/traccar [up|down|status|logs|reset|dev]" >&2; exit 1 ;;
esac
