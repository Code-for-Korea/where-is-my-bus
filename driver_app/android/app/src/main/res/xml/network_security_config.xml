<?xml version="1.0" encoding="utf-8"?>
<!-- ponytail: 임시 테스트 Traccar 서버(http, TLS 없음)용 평문 허용 예외. 실제 배포 서버가 https로
     정해지면 이 파일과 AndroidManifest의 networkSecurityConfig 참조를 제거할 것. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">yehyunserver.iptime.org</domain>
    </domain-config>
</network-security-config>
