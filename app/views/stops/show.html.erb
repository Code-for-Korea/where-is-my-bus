<% content_for :title, "#{@stop.name} | 내 버스는 언제 올까?" %>

<div class="px-5 py-8">
  <%= link_to "← 정류장 선택", root_path, class: "text-sm text-gray-400 hover:text-gray-600" %>
  <h1 class="mt-3 text-2xl font-bold text-gray-900"><%= @stop.name %></h1>

  <% if @routes.empty? %>
    <p class="mt-8 rounded-xl bg-gray-50 p-5 text-center text-sm text-gray-500">이 정류장에 서는 노선이 없습니다.</p>
  <% else %>
    <p class="mt-1 text-sm text-gray-500">기다리는 노선을 골라 주세요.</p>
    <ul class="mt-5 space-y-3">
      <% @routes.each do |route| %>
        <% running = @active_trip_counts.fetch(route.id, 0) %>
        <li>
          <%= link_to stop_route_arrivals_path(@stop, route),
                class: "flex items-center justify-between rounded-xl border border-gray-200 px-4 py-4 hover:bg-gray-50" do %>
            <span class="font-medium text-gray-900"><%= route.name %></span>
            <span class="text-sm <%= running.positive? ? "text-green-600" : "text-gray-400" %>">
              <%= running.positive? ? "운행 중 #{running}대" : "운행 중인 버스 없음" %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
