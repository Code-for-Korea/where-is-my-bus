<% content_for :title, "#{@stop.name} · #{@route.name} | 내 버스는 언제 올까?" %>

<div class="px-5 py-8">
  <%= link_to "← #{@stop.name}", stop_path(@stop), class: "text-sm text-gray-400 hover:text-gray-600" %>
  <h1 class="mt-3 text-2xl font-bold text-gray-900"><%= @route.name %></h1>
  <p class="mt-1 text-sm text-gray-500">내 정류장: <strong class="text-gray-800"><%= @stop.name %></strong></p>

  <div class="mt-6" data-controller="refresh"
       data-refresh-url-value="<%= stop_route_buses_path(@stop, @route) %>">
    <%= render "arrivals/buses", statuses: @statuses, route_stops: @route_stops, stop: @stop %>
  </div>
</div>
