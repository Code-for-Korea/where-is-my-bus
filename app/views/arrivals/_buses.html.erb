<section class="space-y-3">
  <% if statuses.empty? %>
    <div class="rounded-xl bg-gray-50 p-5 text-center text-sm text-gray-500">현재 이 노선으로 운행 중인 버스가 없습니다.</div>
  <% end %>

  <% statuses.each do |status| %>
    <div class="rounded-xl border px-4 py-4 <%= status_card_classes(status) %>">
      <div class="flex items-center justify-between">
        <span class="text-sm font-semibold text-gray-700"><%= bus_label(status.bus) %></span>
        <span class="font-bold <%= status.kind == :arriving ? "text-green-600" : "text-gray-900" %>"><%= status_headline(status) %></span>
      </div>
      <% if (detail = status_detail(status)) %>
        <p class="mt-1 text-sm text-gray-500"><%= detail %></p>
      <% end %>
    </div>
  <% end %>
</section>

<section class="mt-8">
  <h2 class="text-sm font-semibold text-gray-500">노선 진행 현황</h2>
  <ol class="mt-3 space-y-1">
    <% route_stops.each do |route_stop| %>
      <% mine = route_stop.stop_id == stop.id %>
      <% here = statuses.select { |s| s.last_stop&.id == route_stop.stop_id } %>
      <li class="flex items-start gap-3 rounded-lg px-3 py-2 <%= mine ? "bg-indigo-50" : "" %>">
        <span class="mt-1.5 inline-block h-2.5 w-2.5 shrink-0 rounded-full <%= here.any? ? "bg-green-500" : (mine ? "bg-indigo-500" : "bg-gray-300") %>"></span>
        <div class="min-w-0">
          <div class="text-sm <%= mine ? "font-bold text-indigo-700" : "text-gray-800" %>">
            <%= route_stop.stop.name %><%= " (내 정류장)" if mine %>
          </div>
          <% here.each do |status| %>
            <div class="text-xs text-green-600"><%= bus_label(status.bus) %> <%= status.at_last_stop ? "정차 중" : "출발" %></div>
          <% end %>
        </div>
      </li>
    <% end %>
  </ol>
</section>

<p class="mt-6 text-center text-xs text-gray-300">마지막 갱신 <%= Time.current.strftime("%H:%M:%S") %></p>
