<% content_for :page_title, "설정" %>

<%= form_with url: admin_setting_path, method: :patch, scope: :settings, class: "space-y-5 max-w-lg" do |f| %>
  <fieldset>
    <legend class="block text-sm font-medium text-gray-700 mb-2">지도 제공자</legend>
    <div class="space-y-2">
      <% Admin::SettingsController::MAP_PROVIDERS.each do |value, config| %>
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <%= f.radio_button :map_provider, value, checked: @provider == value,
                class: "text-indigo-600 focus:ring-indigo-500" %>
          <%= config[:label] %>
          <% if config[:key_setting].nil? %>
            <span class="text-xs text-gray-400">(API 키 불필요)</span>
          <% end %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <% key_config = Admin::SettingsController::MAP_PROVIDERS[@provider] %>
  <% if key_config[:key_setting] %>
    <div>
      <%= f.label :api_key, key_config[:key_label], class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :api_key, value: @api_key, placeholder: "API 키 입력",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-indigo-500 focus:ring-indigo-500" %>
      <p class="mt-1 text-xs text-gray-400">
        지도 화면에 그대로 전송되는 값입니다. 각 콘솔(Google Cloud / Kakao Developers)에서
        도메인 제한을 걸어 주세요. 비우고 저장하면 키가 해제됩니다.
      </p>
    </div>
  <% end %>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to "취소", admin_root_path, class: "text-sm text-gray-500 hover:text-gray-900" %>
  </div>
<% end %>
