<% content_for :page_title, "정류장" %>

<div class="flex items-center justify-between mb-5">
  <p class="text-sm text-gray-500">총 <%= @stops.size %>개</p>
  <%= link_to "정류장 추가", new_admin_stop_path,
        class: "inline-flex items-center px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700" %>
</div>

<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-gray-500 text-left">
      <tr>
        <th class="px-5 py-3 font-medium">정류장</th>
        <th class="px-5 py-3 font-medium">좌표</th>
        <th class="px-5 py-3 font-medium">정차하는 노선</th>
        <th class="px-5 py-3 font-medium w-32">Traccar 정류장 영역</th>
        <th class="px-5 py-3 font-medium w-32 text-right">관리</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @stops.each do |stop| %>
        <tr class="hover:bg-gray-50">
          <td class="px-5 py-3 font-medium">
            <%= link_to stop.name, admin_stop_path(stop), class: "text-indigo-600 hover:underline" %>
          </td>
          <td class="px-5 py-3 text-gray-500 font-mono text-xs"><%= stop.lat.to_f %>, <%= stop.lng.to_f %></td>
          <td class="px-5 py-3 text-gray-500"><%= stop.routes.map(&:name).join(", ").presence || "—" %></td>
          <td class="px-5 py-3 text-gray-500 font-mono"><%= stop.traccar_geofence_id || "—" %></td>
          <td class="px-5 py-3 text-right space-x-3">
            <%= link_to "수정", edit_admin_stop_path(stop), class: "text-gray-500 hover:text-gray-900" %>
            <%= button_to "삭제", admin_stop_path(stop), method: :delete,
                  form: { data: { turbo_confirm: "삭제하시겠습니까?" }, class: "inline" },
                  class: "text-red-500 hover:text-red-700" %>
          </td>
        </tr>
      <% end %>
      <% if @stops.empty? %>
        <tr><td colspan="5" class="px-5 py-10 text-center text-gray-400">등록된 정류장이 없습니다.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
