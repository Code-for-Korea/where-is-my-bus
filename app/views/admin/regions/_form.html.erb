<% input_class = "w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-indigo-500 focus:ring-indigo-500" %>
<%= form_with model: [:admin, region], class: "space-y-5 max-w-lg" do |f| %>
  <%= render "admin/shared/errors", record: region %>

  <div>
    <%= f.label :name, "지역명", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, placeholder: "예: 울릉읍", class: input_class %>
  </div>

  <div>
    <%= f.label :code, "코드", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :code, placeholder: "예: 4794025000", class: input_class %>
    <% if region.persisted? %>
      <p class="mt-1 text-xs text-yellow-700">코드는 외부 데이터(법정동코드)와 이어 주는 키입니다. 바꾸면 다음 적재 때 새 지역으로 추가됩니다.</p>
    <% end %>
  </div>

  <div>
    <%= f.label :parent_code, "상위 지역 코드", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :parent_code, placeholder: "비워 두면 최상위 지역", class: input_class %>
    <% if region.parent %>
      <p class="mt-1 text-xs text-gray-500"><%= region.parent.full_name %></p>
    <% end %>
  </div>

  <div class="flex gap-4">
    <div class="flex-1">
      <%= f.label :level, "레벨", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :level, min: 1, step: 1, class: input_class %>
    </div>
    <div class="flex-1">
      <%= f.label :kind, "종류", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :kind, placeholder: "예: 읍면동", class: input_class %>
    </div>
  </div>

  <% content_for :head do %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H" crossorigin="anonymous">
  <% end %>

  <div class="space-y-3" data-controller="region-bounds"
       data-region-bounds-initial-bounds-value="<%= (region.own_bounds || []).to_json %>"
       data-region-bounds-fallback-bounds-value="<%= (region.parent&.bounds || Region.country_bounds || []).to_json %>">
    <div>
      <p class="block text-sm font-medium text-gray-700 mb-1">영역 (남·서·북·동, 모두 입력하거나 모두 비움)</p>
      <p class="text-xs text-gray-500 mb-2">지도를 원하는 범위에 맞춘 뒤 버튼을 누르면 값이 채워집니다. 저장은 아래 등록/수정 버튼으로 합니다.</p>
      <div class="grid grid-cols-2 gap-4">
        <% { south: "남", west: "서", north: "북", east: "동" }.each do |attr, label| %>
          <div>
            <%= f.label attr, label, class: "block text-xs text-gray-500 mb-1" %>
            <%= f.text_field attr, inputmode: "decimal",
                  data: { region_bounds_target: attr, action: "input->region-bounds#syncFromInputs" },
                  class: input_class %>
          </div>
        <% end %>
      </div>
    </div>

    <div>
      <div data-region-bounds-target="canvas" class="isolate h-72 w-full rounded-lg border border-gray-300 bg-gray-100"></div>
      <p data-region-bounds-target="status" class="mt-1 text-xs text-gray-400">지도를 움직이거나 확대·축소해 범위를 맞추세요.</p>
    </div>

    <div class="flex items-center gap-2">
      <button type="button" data-action="click->region-bounds#useCurrentView"
              class="px-3 py-1.5 rounded-lg border border-indigo-600 text-indigo-600 text-sm font-medium hover:bg-indigo-50 cursor-pointer">현재 지도 범위를 영역으로 저장</button>
      <button type="button" data-action="click->region-bounds#clear"
              class="px-3 py-1.5 rounded-lg border border-gray-300 text-gray-600 text-sm hover:bg-gray-50 cursor-pointer">영역 지우기</button>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "rounded border-gray-300" %>
    <%= f.label :active, "활성", class: "text-sm text-gray-700" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to "취소", (region.persisted? ? admin_region_path(region) : admin_regions_path(region_id: region.parent_id)), class: "text-sm text-gray-500 hover:text-gray-900" %>
  </div>
<% end %>
