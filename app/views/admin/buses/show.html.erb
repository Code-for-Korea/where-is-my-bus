<% content_for :page_title, @bus.license_plate %>

<div class="bg-white rounded-xl border border-gray-200 p-6 max-w-lg space-y-4">
  <div>
    <div class="text-xs text-gray-400">운행지역</div>
    <div class="font-medium"><%= @bus.area.full_name %></div>
  </div>
  <div>
    <div class="text-xs text-gray-400">번호판</div>
    <div class="font-medium"><%= @bus.license_plate %></div>
  </div>
  <div>
    <div class="text-xs text-gray-400">PIN</div>
    <div class="flex items-center gap-3">
      <div class="font-medium font-mono"><%= @bus.pin %></div>
      <%= button_to "재발급", regenerate_pin_admin_bus_path(@bus), method: :post,
            form: { data: { turbo_confirm: "PIN을 재발급하시겠습니까? 기존 PIN은 즉시 무효화됩니다." }, class: "inline" },
            class: "text-xs text-indigo-600 underline cursor-pointer" %>
    </div>
    <p class="mt-1 text-xs text-gray-400">유출 등으로 무효화가 필요하면 재발급하세요 — 운전자는 새 PIN으로 재등록해야 합니다.</p>
  </div>
  <div>
    <div class="text-xs text-gray-400">단말 식별자 (traccar_unique_id)</div>
    <div class="font-medium font-mono"><%= @bus.traccar_unique_id %></div>
  </div>
  <div>
    <div class="text-xs text-gray-400">Traccar 연동 상태</div>
    <div class="flex items-center gap-3">
      <% if @bus.traccar_device_id.present? %>
        <div class="font-medium">연동됨 (device id: <%= @bus.traccar_device_id %>)</div>
      <% else %>
        <div class="font-medium text-amber-600">미연동</div>
      <% end %>
      <%= button_to "재동기화", sync_device_admin_bus_path(@bus), method: :post,
            class: "text-xs text-indigo-600 underline cursor-pointer" %>
    </div>
  </div>
  <div>
    <div class="text-xs text-gray-400">최종수정일자</div>
    <div class="font-medium"><%= @bus.updated_at.strftime("%Y-%m-%d %H:%M") %></div>
  </div>

  <div class="flex items-center gap-3 pt-2 border-t border-gray-100">
    <%= link_to "수정", edit_admin_bus_path(@bus),
          class: "px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700" %>
    <%= link_to "목록", admin_buses_path, class: "text-sm text-gray-500 hover:text-gray-900" %>
  </div>
</div>
