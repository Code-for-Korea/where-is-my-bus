<!DOCTYPE html>
<html lang="ko">
  <head>
    <% _title       = content_for?(:title)       ? "#{yield(:title)} | 로컬버스" : "내 버스는 언제올까? | 로컬버스" %>
    <% _description = content_for?(:description) ? yield(:description)           : "지방 소도시 버스 도착 정보를 실시간으로 확인하세요. 스마트폰 QR로 이용하는 무료 버스 알리미." %>
    <title><%= _title %></title>
    <meta name="description" content="<%= _description %>">
    <meta property="og:type"        content="website">
    <meta property="og:title"       content="<%= _title %>">
    <meta property="og:description" content="<%= _description %>">
    <% if (site_url = Rails.application.credentials.site_url).present? %>
      <meta property="og:url"   content="<%= "#{site_url}#{request.path}" %>">
      <meta property="og:image" content="<%= "#{site_url}/bus_hero.png" %>">
    <% end %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <% if Rails.env.production? %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-V5FQ7DHE99"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        // 페이지뷰는 Turbo 이동에서도 보내야 하므로 ga4.js가 turbo:load마다 직접 보낸다.
        gtag('config', 'G-V5FQ7DHE99', { send_page_view: false });
      </script>
    <% end %>
    <style>
      body { font-family: 'Pretendard Variable', Pretendard, sans-serif; }
    </style>
  </head>

  <body class="bg-gray-100 min-h-screen"<% if content_for?(:ga4_page_path) %> data-ga4-page-path="<%= yield(:ga4_page_path) %>"<% end %>>
    <div class="mx-auto w-full sm:max-w-[400px]">
      <div class="relative bg-white overflow-hidden min-h-screen flex flex-col">
        <!-- 플래시 -->
        <% if notice %>
          <div class="mx-6 mt-2 rounded-lg bg-green-50 text-green-800 px-3 py-2 text-sm shrink-0"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="mx-6 mt-2 rounded-lg bg-red-50 text-red-800 px-3 py-2 text-sm shrink-0"><%= alert %></div>
        <% end %>

        <!-- 화면 본문 -->
        <div class="flex-1 flex flex-col min-h-0">
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
