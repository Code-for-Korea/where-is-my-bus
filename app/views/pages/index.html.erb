<% content_for :title, "내 버스는 언제 올까?" %>

<div class="px-5 py-8" data-controller="filter">
  <h1 class="text-2xl font-bold text-gray-900">내 버스는 언제 올까?</h1>
  <p class="mt-1 text-sm text-gray-500">기다리는 정류장을 골라 주세요.</p>

  <input type="search" placeholder="정류장 검색" autocomplete="off"
         data-action="input->filter#apply"
         class="mt-5 w-full rounded-xl border border-gray-300 px-4 py-3 text-base focus:border-indigo-500 focus:ring-indigo-500">

  <ul class="mt-4 divide-y divide-gray-100 rounded-xl border border-gray-200 overflow-hidden">
    <% @stops.each do |stop| %>
      <li data-filter-target="item" data-text="<%= stop.name %>">
        <%= link_to stop_path(stop), class: "flex items-center justify-between px-4 py-4 hover:bg-gray-50" do %>
          <span class="font-medium text-gray-900"><%= stop.name %></span>
          <span class="text-xs text-gray-400"><%= stop.routes.map(&:name).join(" · ") %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if @stops.empty? %>
    <p class="mt-8 text-center text-sm text-gray-400">아직 노선에 등록된 정류장이 없습니다.</p>
  <% end %>
  <p class="hidden mt-8 text-center text-sm text-gray-400" data-filter-target="empty">검색 결과가 없습니다.</p>

  <p class="mt-10 text-center text-xs text-gray-300"><%= link_to "관리자", admin_root_path, class: "hover:text-gray-500" %></p>
</div>
